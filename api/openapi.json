  "components": {
    "securitySchemes": {
      "adminBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "enrollmentBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A scoped, one-use enrollment token. Generate 32 random bytes and encode them as canonical unpadded base64url."
      }
    },
    "schemas": {
      "CreateCluster": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "name",
          "engine"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "engine": {
            "type": "string",
            "enum": [
              "postgres",
              "redis"
            ]
          },
          "postgresql": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "topology"
                ],
                "properties": {
                  "version": {
                    "type": "string",
                    "enum": [
                      "17.11",
                      "18.6"
                    ]
                  },
                  "topology": {
                    "const": "standalone"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "redis": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "topology",
                  "persistence"
                ],
                "properties": {
                  "version": {
                    "const": "8.2.7"
                  },
                  "topology": {
                    "const": "standalone"
                  },
                  "persistence": {
                    "enum": [
                      "none",
                      "rdb",
                      "aof",
                      "rdb+aof"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "engine": {
                "const": "postgres"
              },
              "postgresql": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "topology"
                ],
                "properties": {
                  "version": {
                    "type": "string",
                    "enum": [
                      "17.11",
                      "18.6"
                    ]
                  },
                  "topology": {
                    "const": "standalone"
                  }
                }
              },
              "redis": {
                "type": "null"
              }
            },
            "required": [
              "postgresql"
            ]
          },
          {
            "properties": {
              "engine": {
                "const": "redis"
              },
              "redis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "topology",
                  "persistence"
                ],
                "properties": {
                  "version": {
                    "const": "8.2.7"
                  },
                  "topology": {
                    "const": "standalone"
                  },
                  "persistence": {
                    "enum": [
                      "none",
                      "rdb",
                      "aof",
                      "rdb+aof"
                    ]
                  }
                }
              },
              "postgresql": {
                "type": "null"
              }
            },
            "required": [
              "redis"
            ]
          }
        ]
      },
      "Admission": {
        "type": "object",
        "required": [
          "cluster_id",
          "operation_id",
          "desired_revision",
          "accepted_at",
          "replayed"
        ],
        "properties": {
          "cluster_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "desired_revision": {
            "type": "integer",
            "format": "int64"
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Cluster": {
        "type": "object",
        "required": [
          "id",
          "installation_id",
          "spec",
          "desired_revision",
          "desired_lifecycle",
          "observed_revision",
          "observed_lifecycle",
          "execution_epoch",
          "created_at",
          "updated_at",
          "deleted_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "spec": {
            "$ref": "#/components/schemas/CreateCluster"
          },
          "desired_revision": {
            "type": "integer",
            "format": "int64"
          },
          "desired_lifecycle": {
            "type": "string"
          },
          "observed_revision": {
            "type": "integer",
            "format": "int64"
          },
          "observed_lifecycle": {
            "type": "string"
          },
          "execution_epoch": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Operation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "cluster_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string"
          },
          "api_operation": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "desired_revision": {
            "type": "integer",
            "format": "int64"
          },
          "plan_version": {
            "type": "integer",
            "format": "int64"
          },
          "execution_epoch": {
            "type": "integer",
            "format": "int64"
          },
          "attempts": {
            "type": "integer",
            "format": "int64"
          },
          "owner_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "next_attempt_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancellation_requested_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
