{
  "openapi": "3.1.0",
  "info": {
    "title": "Synod development API",
    "version": "0.1.0-dev",
    "description": "Development API for cluster admission, inspection, and node enrollment. No provisioning worker is connected. Version values are development candidates."
  },
  "servers": [
    {
      "url": "https://localhost:8443"
    }
  ],
  "security": [
    {
      "adminBearer": []
    }
