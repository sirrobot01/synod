{
  "openapi": "3.1.0",
  "info": {
    "title": "Synod development API",
    "version": "0.1.0-dev",
    "description": "Development API for node enrollment, node policy, and operation inspection. The app endpoints are not described here yet."
  },
  "servers": [
    {
      "url": "https://localhost:8443"
    }
  ],
  "security": [
    {
      "adminBearer": []
    }
  ],
  "paths": {
    "/v1/operations/{id}": {
      "get": {
        "operationId": "getOperation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource or endpoint not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Metadata unavailable or commit outcome unknown; retry with the same key and body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. Retry after one second.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/enrollment-tokens": {
      "post": {
        "operationId": "registerEnrollmentToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterEnrollmentToken"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Committed security result. Repeat the same request to recover its result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentToken"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid enrollment credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting registration or enrollment identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Delay in seconds before retry."
              }
            }
          },
          "503": {
            "description": "Metadata or signing service unavailable; retain request identity on uncertain outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]{1,128}$"
            }
          }
        ]
      }
    },
    "/v1/enrollments": {
      "post": {
        "operationId": "enrollAgent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollAgent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Committed security result. Repeat the same request to recover its result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid enrollment credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting registration or enrollment identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Delay in seconds before retry."
              }
            }
          },
          "503": {
            "description": "Metadata or signing service unavailable; retain request identity on uncertain outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "enrollmentBearer": []
          }
        ]
      }
    },
    "/v1/nodes/{id}/certificates/{certificate_id}/actions/revoke": {
      "post": {
        "operationId": "revokeAgentCertificate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeAgentCertificate"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Committed security result. Repeat the same request to recover its result."
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid enrollment credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting registration or enrollment identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Delay in seconds before retry."
              }
            }
          },
          "503": {
            "description": "Metadata or signing service unavailable; retain request identity on uncertain outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "certificate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/v1/nodes/{id}/placement-policy": {
      "put": {
        "operationId": "putNodePlacementPolicy",
        "description": "Declare placement and client address policy for an enrolled node. Requires administrator access. Use revision zero for a node with no policy. Later updates must name the current policy revision. No host operation is created.",
        "security": [
          {
            "adminBearer": []
          },
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "Exactly one nonnegative policy revision, with optional double quotes. Zero creates the first policy.",
            "schema": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*|\"(?:0|[1-9][0-9]*)\")$"
            }
          },
          {
            "$ref": "#/components/parameters/BrowserOrigin"
          },
          {
            "$ref": "#/components/parameters/BrowserFetchSite"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodePlacementPolicy"
              }
            }
          }
        },
        "responses": {
          "400": {
            "$ref": "#/components/responses/NodePolicyBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/ActionUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ActionForbidden"
          },
          "404": {
            "$ref": "#/components/responses/NodePolicyNotFound"
          },
          "405": {
            "$ref": "#/components/responses/ActionMethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/ActionRateLimit"
          },
          "500": {
            "$ref": "#/components/responses/ActionInternalError"
          },
          "503": {
            "$ref": "#/components/responses/ConnectionUnavailable"
          },
          "412": {
            "$ref": "#/components/responses/ActionRevisionConflict"
          },
          "413": {
            "$ref": "#/components/responses/ActionTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/ActionMediaType"
          },
          "422": {
            "$ref": "#/components/responses/NodePolicyUnsupported"
          },
          "200": {
            "description": "The placement policy was stored with its new revision.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "const": "nosniff"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Quoted policy revision."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodePolicyResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/installation": {
      "get": {
        "operationId": "getInstallation",
        "description": "Read the installation ID and the current recovery generation. An agent configuration needs both. The recovery generation can change after controller recovery. Read it when you write a new agent configuration. Before a controller runner records a generation, the API returns 503 with code recovery_generation_unavailable.",
        "responses": {
          "200": {
            "description": "The installation identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Installation"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. Retry after one second.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No recovery generation is recorded, or the metadata service is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "enrollmentBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A scoped, one-use enrollment token. Generate 32 random bytes and encode them as canonical unpadded base64url."
      },
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-synod_session",
        "description": "An authenticated administrator session. Unsafe requests must supply a matching Origin or Sec-Fetch-Site: same-origin."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Operation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "app_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string"
          },
          "api_operation": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "desired_revision": {
            "type": "integer",
            "format": "int64"
          },
          "plan_version": {
            "type": "integer",
            "format": "int64"
          },
          "execution_epoch": {
            "type": "integer",
            "format": "int64"
          },
          "attempts": {
            "type": "integer",
            "format": "int64"
          },
          "owner_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "next_attempt_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancellation_requested_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "waiting",
              "cancelling",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "retry_of": {
            "type": "string",
            "format": "uuid",
            "description": "The prior failed or cancelled replica-add operation. Absent for an initial operation."
          }
        },
        "required": [
          "id",
          "installation_id",
          "app_id",
          "actor_id",
          "api_operation",
          "kind",
          "desired_revision",
          "plan_version",
          "execution_epoch",
          "attempts",
          "owner_id",
          "failure_code",
          "claim_expires_at",
          "next_attempt_at",
          "cancellation_requested_at",
          "finished_at",
          "created_at",
          "updated_at",
          "status"
        ]
      },
      "RegisterEnrollmentToken": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "token",
          "ttl_seconds"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 3600
          }
        }
      },
      "EnrollmentToken": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "node_id",
          "expires_at",
          "replayed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "EnrollAgent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "request_id",
          "csr_der"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "csr_der": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "DER Ed25519 CSR. Retain these exact bytes and the local private key through retries."
          }
        }
      },
      "EnrollmentResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "certificate_id",
          "certificate_pem",
          "ca_certificate_pem",
          "accepted_at",
          "replayed"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "certificate_id": {
            "type": "string",
            "format": "uuid"
          },
          "certificate_pem": {
            "type": "string"
          },
          "ca_certificate_pem": {
            "type": "string"
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "RevokeAgentCertificate": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "NodePlacementPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "architecture",
          "runtime_version",
          "storage_id",
          "engines",
          "headroom"
        ],
        "properties": {
          "architecture": {
            "type": "string",
            "enum": [
              "amd64",
              "arm64"
            ]
          },
          "runtime_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]{1,128}$"
          },
          "storage_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]{1,128}$"
          },
          "client_address": {
            "type": "string",
            "description": "Optional canonical unicast IPv4 or IPv6 literal. Private LAN addresses are valid. Refuse loopback, link-local, multicast, unspecified, mapped, zone-bearing, and noncanonical addresses. Empty or omitted keeps the node eligible but endpoint discovery reports client_address_required. This is declared operator intent, not an address inferred from a control connection.",
            "anyOf": [
              {
                "const": ""
              },
              {
                "format": "ipv4"
              },
              {
                "format": "ipv6"
              }
            ]
          },
          "engines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "version"
              ],
              "properties": {
                "engine": {
                  "type": "string",
                  "enum": [
                    "postgres",
                    "redis"
                  ]
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[!-~]{1,128}$"
                }
              }
            }
          },
          "labels": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]{1,128}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
