  "components": {
    "securitySchemes": {
      "adminBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "enrollmentBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A scoped, one-use enrollment token. Generate 32 random bytes and encode them as canonical unpadded base64url."
      },
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-synod_session",
        "description": "An authenticated administrator session. Unsafe requests must supply a matching Origin or Sec-Fetch-Site: same-origin."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Operation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "app_id": {
            "type": "string",
            "format": "uuid"
          },
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "failure_code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "waiting",
              "cancelling",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "app_id",
          "node_id",
          "actor_id",
          "kind",
          "failure_code",
          "status",
          "created_at",
          "updated_at",
          "finished_at"
        ]
      },
      "RegisterEnrollmentToken": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "token",
          "ttl_seconds"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
